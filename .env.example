# =============================================================================
# ClinicApp - configuracion de la raiz
#
# `docker compose` lee este archivo automaticamente. Se copia a `.env`:
#
#     cp .env.example .env
#
# Los valores de aqui sirven para DESARROLLO LOCAL. En produccion se inyectan
# por el gestor de secretos del entorno (no por archivo), y las claves
# predeterminadas DEBEN cambiarse.
# =============================================================================

# --- Aplicacion Laravel ------------------------------------------------------
APP_NAME=ClinicApp
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000
# La base de datos trabaja en UTC; la zona de clinia se define en
# CLINIC_TIMEZONE y solo afecta a las reglas de jornada laboral.
APP_TIMEZONE=UTC
APP_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Puertos publicados en el host -------------------------------------------
APP_PORT=8000
NOTIFICATIONS_PORT=8001
GATEWAY_PORT=8080
POSTGRES_PORT=5432

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic_local_password
POSTGRES_DB=clinic_app
# Base separada para el microservicio de notificaciones: aislamiento logico sin
# un segundo contenedor para la demostracion.
POSTGRES_NOTIFICATIONS_DB=clinic_notifications

# --- Seguridad entre servicios ----------------------------------------------
# Claves de DESARROLLO. En produccion: 32+ caracteres aleatorios, distintos entre
# servicios, y nunca las mismas.
INTERNAL_API_KEY=dev-clinic-key-change-me
NOTIFICATIONS_API_KEY=dev-notifications-key-change-me
NOTIFICATIONS_VERSION=1.0.0

# --- Canal de notificaciones -------------------------------------------------
# `log` deja la notificacion en el log del contenedor. `webhook` la envia a un
# sistema externo; en ese caso hay que indicar la URL.
NOTIFICATIONS_CHANNEL=log
NOTIFICATIONS_WEBHOOK_URL=

# --- Configuracion de clinia -------------------------------------------------
# Zona usada por las reglas de jornada laboral y por los reportes diarios.
CLINIC_TIMEZONE=America/Bogota
CLINIC_NAME=ClinicApp Centro Medico
