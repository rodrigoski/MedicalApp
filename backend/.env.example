APP_NAME=ClinicApp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=1.0.0

# TODO EL SISTEMA OPERA EN UTC
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# ------------------------------------------------------------------ Base de datos
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=clinic_app
DB_USERNAME=clinic
DB_PASSWORD=clinic_local_password
DB_SSLMODE=prefer

CACHE_STORE=database
CACHE_PREFIX=clinicapp_cache
SESSION_DRIVER=array
QUEUE_CONNECTION=database

# ------------------------------------------------- Seguridad / integracion interna
# Claves de la API interna (cabecera X-Api-Key). Separadas por coma para rotar.
INTERNAL_API_KEY=dev-clinic-key-change-me

# Microservicio de notificaciones (FastAPI)
NOTIFICATION_SERVICE_URL=http://notification-service:8000
NOTIFICATION_SERVICE_API_KEY=dev-notifications-key-change-me
NOTIFICATION_SERVICE_TIMEOUT=4
NOTIFICATION_SERVICE_RETRIES=2

# ------------------------------------------------------------- Reglas de la clinica
CLINIC_MAX_APPOINTMENTS_PER_DOCTOR_PER_DAY=24
CLINIC_PAST_DATE_TOLERANCE_MINUTES=0
CLINIC_TIMEZONE=America/Bogota
CLINIC_WORKING_HOURS_START=8
CLINIC_WORKING_HOURS_END=18
CLINIC_SLOT_MINUTES=30
CLINIC_EVENTS_RETENTION_DAYS=90
