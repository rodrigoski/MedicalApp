# Configuracion local del microservicio de notificaciones.
# Copiar a `.env`. Los valores de aqui son de DESARROLLO: ninguno sirve para
# produccion.

SERVICE_NAME=notification-service
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

HOST=0.0.0.0
PORT=8000

# Clave compartida con el backend Laravel. Debe coincidir con
# NOTIFICATION_SERVICE_KEY en el .env del backend. Minimo 16 caracteres.
API_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Base de datos propia del microservicio (la crea infra/postgres/init).
DATABASE_URL=postgresql+psycopg://clinic:clinic@postgres:5432/clinic_notifications
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# Politica de reintentos.
MAX_ATTEMPTS=5
BACKOFF_BASE_SECONDS=30
BACKOFF_MAX_SECONDS=3600

# Canal de salida: `log` o `webhook`.
CHANNEL=log
WEBHOOK_URL=
WEBHOOK_TIMEOUT_SECONDS=4

# Procesador en segundo plano.
POLL_INTERVAL_SECONDS=15
BATCH_SIZE=25
